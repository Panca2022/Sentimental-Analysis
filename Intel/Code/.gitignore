@"
# Environment secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/

# Data
data/raw/*
data/processed/*
data/cache/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/outputs/.gitkeep

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
"@ | Set-Content "Intel\Code\.gitignore" -Encoding utf8